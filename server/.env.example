# Backend Server Environment Variables Template
# Copy this to .env or paste these into your Render / Railway / Heroku dashboard

PORT=5000

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Gmail SMTP for system notification emails (optional, fallback from EmailJS)
# Generate App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Razorpay Payment Gateway (Optional in test mode, required for live payments)
# Obtain from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_or_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
